# Edit these values for the LXC environment.
WATCH_TARGET=user@lxc-address
RECOVERY_SCRIPT=/absolute/path/to/setup.sh
REMOTE_HEALTH_COMMAND='curl -fsS --max-time 2 http://127.0.0.1:7860/ >/dev/null'

SSH_PORT=22
ROTATE_CREDENTIALS_ON_FIRST_PING=true
CREDENTIALS_DIR=~/.ssh/osms-recovery

# Watcher timing, in seconds.
CHECK_INTERVAL=2
SSH_RETRY_INTERVAL=1
SSH_CONNECT_TIMEOUT=2

# Keep this at 0 for continuous monitoring. Set a small value while testing.
WATCHER_MAX_CYCLES=0
