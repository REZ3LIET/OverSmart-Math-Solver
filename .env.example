# Edit these values for the LXC environment.
WATCH_TARGET=user@lxc-address
RECOVERY_SCRIPT=bash/setup.sh
REMOTE_HEALTH_COMMAND='if curl --fail --silent --max-time 2 http://127.0.0.1:8015/healthz >/dev/null || curl --fail --silent --max-time 2 http://127.0.0.1:8015/ >/dev/null; then printf healthy; else pid=$(cat "$HOME/OverSmart-Math-Solver/.runtime/app.pid" 2>/dev/null || true); test -n "$pid" && kill -0 "$pid" 2>/dev/null && printf busy; fi'
REMOTE_STATUS_COMMAND='cat "$HOME/.check/status" 2>/dev/null || printf missing'

# Configure this once. The watcher tries its stable key first and automatically
# falls back to this original key after an LXC rebuild.
BOOTSTRAP_SSH_IDENTITY_FILE=/absolute/path/to/student-admin_key
SSH_PORT=22
UPDATE_SSH_KEY_ON_FIRST_PING=true
CREDENTIALS_DIR=~/.ssh/osms-recovery
DEPLOY_CACHE_ARCHIVE=/root/osms-deploy-cache/osms-runtime-cache.tar
# This server benchmarked faster without the full archive. Enable it when
# offline/reliable restoration matters more than raw recovery time.
USE_DEPLOY_CACHE=false

# Install this model during recovery and load it before health becomes ready.
OSMS_MODEL_NAME=unsloth/Qwen2.5-Coder-3B-Instruct-bnb-4bit
OSMS_PRELOAD_LOCAL_MODEL=true

# Watcher timing, in seconds.
CHECK_INTERVAL=2
SETUP_CHECK_INTERVAL=15
DEPLOY_CHECK_INTERVAL=30
SSH_RETRY_INTERVAL=1
SSH_CONNECT_TIMEOUT=2

# `accept-new` trusts first contact but rejects a changed server identity.
# A disposable lab LXC that regenerates its host key needs `no` for fully
# unattended recovery; see bash/README.md for the security tradeoff.
SSH_STRICT_HOST_KEY_CHECKING=accept-new
SSH_DIAGNOSTIC_INTERVAL=5

# Reuse one authenticated SSH connection for repeated probes.
SSH_MULTIPLEXING=true
SSH_CONTROL_PERSIST=60

# Resource monitoring and warning thresholds.
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80
GPU_THRESHOLD=80
GPU_MEMORY_THRESHOLD=80
RESOURCE_ALERT_COOLDOWN=60
RESOURCE_LOG_FILE=logs/resource_usage.csv
